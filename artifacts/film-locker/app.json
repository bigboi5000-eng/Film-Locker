{
  "expo": {
    "name": "Film Locker",
    "slug": "film-locker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "film-locker",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.filmlocker.app"
    },
    "android": {
      "backgroundColor": "#FFFFFF",
      "package": "com.filmlocker.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B0B0C"
      },
      "gradleProperties": {
        "org.gradle.jvmargs": "-Xmx4g -XX:MaxMetaspaceSize=512m",
        "org.gradle.daemon": "false",
        "android.useAndroidX": "true",
        "android.enableJetifier": "true"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0066FF",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "pickFirst": ["META-INF/versions/9/OSGI-INF/MANIFEST.MF"]
            }
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Film Locker needs access to your photos so you can pick a screenshot or poster and have the films in it identified.",
          "cameraPermission": "Film Locker needs access to your camera so you can photograph a poster or cinema listing and have the films on it identified."
        }
      ],
      [
        "expo-share-intent",
        {
          "disableIOS": true,
          "androidIntentFilters": ["text/*"]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "aaa7f524-ca21-4584-ac07-3ff3e066e9c1"
      }
    }
  }
}
